    {
      "parameters": {
        "jsCode": "const role = $json.role;\nreturn { json: { searchUrl: `https://remoteok.com/api?tag=${encodeURIComponent(role.toLowerCase())}`, role, minScore: $json.minScore } };"
      },
      "id": "3e934c27-7098-4cb2-bb3c-8bea5e5d4876",
      "name": "Build Search Request",
      "type": "n8n-nodes-base.code",
