    {
      "parameters": {
        "jsCode": "const incomingJobs = $('Dedupe & Hard Filters').all().map(i => i.json);\nconst trackedJobs = $input.all().map(i => i.json.URL || i.json.ID);\nconst trackedSet = new Set(trackedJobs.filter(Boolean));\nconst newJobs = incomingJobs.filter(j => !trackedSet.has(j.url) && !trackedSet.has(j.id));\nreturn newJobs.map(j => ({ json: j }));"
      },
