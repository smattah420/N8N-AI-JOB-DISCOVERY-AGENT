    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst role = input['Job Title / Keyword'] || 'Python Developer';\nconst minScore = parseInt(input['Minimum Score']) || 70;\n\nreturn {\n  json: {\n    role: role.trim(),\n    minScore: minScore,\n    isValid: role.trim().length > 0\n  }\n};"
      },
