      "name": "Fetch Jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst rawJobs = items[0].json;\nconst cleanList = Array.isArray(rawJobs) ? rawJobs.slice(1) : [];\nreturn cleanList.map(j => ({ json: { id: j.id || j.slug || j.url, title: j.position || 'N/A', company: j.company || 'N/A', location: j.location || 'Remote', tags: j.tags ? j.tags.join(', ') : '', url: j.url || '', description: j.description ? j.description.replace(/<[^>]*>?/gm, '').slice(0, 800) : '' } }));"
      },
      "id": "e63c3f1c-1ebc-4b12-8107-3090b8d36bb7",
      "name": "Normalize Jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1008,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nif (!items.length || !items[0].json) return [];\n\nlet rawData = items[0].json;\n// Handle agar data array ho ya object ke andar array ho\nconst cleanList = Array.isArray(rawData) ? rawData : (rawData.jobs || []);\n\nreturn cleanList.map(j => ({\n  json: {\n    id: j.id || j.slug || j.url || Math.random().toString(),\n    title: j.position || j.title || 'N/A',\n    company: j.company || 'N/A',\n    location: j.location || 'Remote',\n    tags: Array.isArray(j.tags) ? j.tags.join(', ') : (j.tags || ''),\n    url: j.url || '',\n    description: j.description ? j.description.replace(/<[^>]*>?/gm, '').slice(0, 800) : ''\n  }\n}));"
      },
      "id": "05ad031c-6deb-494c-a95a-2dc9685e68a0",
      "name": "Dedupe & Hard Filters",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        160
      ]
    },
