    {
      "parameters": {
        "jsCode": "const job = $input.first().json;\nconst prompt = `Evaluate job match:\\nTitle: ${job.title}\\nCompany: ${job.company}\\nTags: ${job.tags}\\nDesc: ${job.description}\\n\\nCandidate Profile: Python, Django, REST API, n8n, React.\\nRespond in JSON:\\n{\\n  \"match_score\": 85,\\n  \"reasoning\": \"Good fit for backend & automation\"\n}`;\nreturn { json: { ...job, aiPrompt: prompt } };"
      },
      "id": "99b1aac6-9797-4934-aeac-fb4d96bd3e6e",
      "name": "Build AI Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2432,
        160
      ]
