    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:11434/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama3\",\n  \"prompt\": {{ JSON.stringify($json.aiPrompt) }},\n  \"stream\": false\n}",
        "options": {}
      },
      "id": "37d9cd8f-e37a-4cd4-bcb1-eea2db555054",
      "name": "AI Match & Score",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2624,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const job = $('Build AI Request').first().json;\nconst response = $input.first().json;\nlet parsed = {};\nlet isValid = false;\ntry {\n  const rawText = response.response || response.text || '';\n  const cleanJsonMatch = rawText.match(/\\{[\\s\\S]*\\}/);\n  if (cleanJsonMatch) {\n    parsed = JSON.parse(cleanJsonMatch[0]);\n    isValid = typeof parsed.match_score === 'number';\n  }\n} catch (e) { isValid = false; }\nreturn { json: { ...job, aiResponse: parsed, matchScore: parsed.match_score || 0, reasoning: parsed.reasoning || 'Parse error', aiOutputValid: isValid } };"
      },
      "id": "cb0c1847-bf03-4149-80e1-fc21c9bc5f50",
      "name": "Validate AI Output",
